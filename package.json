{
  "name": "epoch-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive atlas of human technological advancement, AGI/ASI forecasting, and 100-year projections",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate-data.ts && tsx scripts/build-search-index.ts",
    "build": "npm run validate && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "d3": "^7.9.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@types/d3": "^7.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
